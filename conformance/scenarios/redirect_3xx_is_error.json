  "call": {
    "op": "me"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/me",
        "headers": {
          "Authorization": "Bearer tmk_live_c0nf0rmance01_TESTSECRETdoNotUseAnywhere0000000000000",
          "User-Agent": {
            "$regex": "^tmailor-[a-z0-9]+/\\d+\\.\\d+\\.\\d+"
          }
        },
        "query": {},
        "json": null
      },
      "response": {
        "status": 302,
        "headers": {
          "Location": "https://evil.example/v1/me",
          "Content-Type": "text/html"
        },
        "body": ""
      }
